<div class="main-password color-{{ section.settings.color_scheme }}">
  <div class="main-password__inner">
    <h1 class="main-password__brand">
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 600
          | image_tag: widths: '200,400,600', sizes: '20rem', alt: shop.name
        }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </h1>

    {%- if shop.password_message != blank -%}
      <p class="main-password__message">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'storefront_password', class: 'main-password__form' -%}
      <label for="password-storefront" class="visually-hidden">
        {{- 'general.password_page.login_form_password_label' | t -}}
      </label>
      <input
        id="password-storefront"
        class="main-password__input field-input"
        type="password"
        name="password"
        required
        autocomplete="current-password"
        placeholder="{{ 'general.password_page.login_form_password_placeholder' | t | escape }}"
        {% if form.errors %}
          aria-invalid="true"
          aria-describedby="password-storefront-error"
        {% endif %}
      >
      <button type="submit" class="main-password__submit btn btn-primary">
        {{- 'general.password_page.login_form_submit' | t -}}
      </button>

      {%- if form.errors -%}
        <p
          id="password-storefront-error"
          class="main-password__error message message-error"
          role="alert"
        >
          {{- 'general.password_page.login_form_error' | t -}}
        </p>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  .main-password {
    display: grid;
    place-items: center;
    min-height: 100dvh;
    padding: var(--space-10) var(--layout-px);
  }

  .main-password__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    width: 100%;
    max-width: 26rem;
    text-align: center;
  }

  .main-password__brand {
    font-size: var(--text-3xl);
    line-height: 1;
    letter-spacing: var(--tracking-tighter);
    text-transform: lowercase;
  }

  .main-password__brand img {
    width: 20rem;
    max-width: 100%;
  }

  .main-password__message {
    font-size: var(--text-lg);
    line-height: var(--text-lg--line-height);
  }

  .main-password__form {
    display: grid;
    grid-template-columns: 1fr auto;
    width: 100%;
  }

  .main-password__input {
    min-width: 0;
    border-right: 0;
    border-radius: var(--radius-sm) 0 0 var(--radius-sm);
  }

  .main-password__submit {
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .main-password__error {
    grid-column: 1 / -1;
    margin-top: var(--space-2);
    text-align: left;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Password",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "surface"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Falls back to the shop name."
    }
  ]
}
{% endschema %}
