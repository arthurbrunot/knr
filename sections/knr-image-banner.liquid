{%- liquid
  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile | default: image
-%}

<div
  class="knr-banner section-spacing color-{{ section.settings.color_scheme }}"
  {% render 'section-spacing', s: section.settings %}
>
  <div class="knr-banner__frame" style="--banner-text: {{ section.settings.text_color }}">
    {%- if image != blank -%}
      <picture class="knr-banner__media">
        <source
          media="(min-width: 1024px)"
          srcset="
            {%- for width in (1..6) -%}
              {%- assign w = width | times: 480 -%}
              {{ image | image_url: width: w }} {{ w }}w{% unless forloop.last %}, {% endunless %}
            {%- endfor -%}
          "
          sizes="100vw"
        >
        {{
          image_mobile
          | image_url: width: 1560
          | image_tag:
            class: 'knr-banner__image',
            widths: '390,780,1170,1560',
            sizes: '100vw',
            loading: 'lazy',
            alt: image.alt
        }}
      </picture>
    {%- endif -%}

    <div class="knr-banner__content">
      {%- if section.settings.eyebrow != blank -%}
        <div class="knr-banner__eyebrow">
          <p class="text-base">{{ section.settings.eyebrow }}</p>
          <span class="knr-banner__rule" aria-hidden="true"></span>
        </div>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <figure class="knr-banner__quote">
          <blockquote class="knr-banner__text">{{ section.settings.text }}</blockquote>
          {%- if section.settings.author != blank -%}
            <figcaption class="knr-banner__author">{{ section.settings.author }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .knr-banner__frame {
    position: relative;
    display: flex;
    min-height: 46.6875rem;
    padding: var(--space-20) var(--space-6);
    overflow: hidden;
    color: var(--banner-text);
    background-color: var(--palette-media);
  }

  .knr-banner__media,
  .knr-banner__frame::after {
    position: absolute;
    inset: 0;
  }

  .knr-banner__frame::after {
    content: '';
    background: linear-gradient(-77.33deg, rgb(130 121 100 / 0) 35.47%, rgb(143 135 119) 108.44%);
    pointer-events: none;
  }

  .knr-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .knr-banner__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-10);
  }

  .knr-banner__eyebrow {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-height: 1.9375rem;
  }

  .knr-banner__rule {
    width: var(--space-4);
    height: var(--border-base);
    background-color: currentColor;
  }

  .knr-banner__quote {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .knr-banner__text {
    font-size: 1.375rem;
    line-height: 1.5rem;
    letter-spacing: var(--tracking-tighter);
  }

  .knr-banner__author {
    font-size: var(--text-xs);
    line-height: var(--text-xs--line-height);
    letter-spacing: var(--tracking-tighter);
  }

  @media (min-width: 1024px) {
    .knr-banner__frame {
      align-items: center;
      min-height: 45rem;
      padding: var(--space-10);
    }

    .knr-banner__frame::after {
      background: linear-gradient(to left, rgb(0 0 0 / 0), rgb(0 0 0 / 0.08));
    }

    .knr-banner__content {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      gap: var(--space-4);
    }

    .knr-banner__eyebrow {
      flex: 1 1 0;
      min-width: 1px;
      min-height: 0;
    }

    .knr-banner__quote {
      flex: none;
      width: 31.875rem;
    }

    .knr-banner__text {
      font-size: var(--text-2xl);
      line-height: var(--text-2xl--line-height);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "KNR - Image banner",
  "tag": "section",
  "class": "knr-image-banner-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color on image",
      "default": "{{ settings.colors.background }}"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image (mobile)",
      "info": "Optional. Portrait crop for screens under 1024px."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Quote"
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author"
    },
    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Inner padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Inner padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Outer margin top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Outer margin bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "custom_mobile_spacing",
      "label": "Custom mobile spacing",
      "default": true,
      "info": "Off: mobile uses half the desktop values."
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Inner padding top (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.custom_mobile_spacing }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Inner padding bottom (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.custom_mobile_spacing }}"
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "label": "Outer margin top (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.custom_mobile_spacing }}"
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "label": "Outer margin bottom (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.custom_mobile_spacing }}"
    }
  ],
  "presets": [
    {
      "name": "KNR - Image banner"
    }
  ]
}
{% endschema %}
