{%- assign items = section.settings.items -%}

{%- if items.size > 0 -%}
  <div
    class="knr-faq section-spacing color-{{ section.settings.color_scheme }}"
    {% render 'section-spacing', s: section.settings %}
  >
    {%- if section.settings.heading != blank -%}
      <h2 class="knr-faq__heading title-h1">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="knr-faq__list">
      {%- for item in items -%}
        <details
          class="knr-faq__item"
          name="faq-{{ section.id }}"
          data-accordion
          {% if forloop.first and section.settings.open_first %}
            open
          {% endif %}
        >
          <summary class="knr-faq__question">
            {{- item.question.value -}}
            <span class="knr-faq__chevron">{% render 'icon-chevron' %}</span>
          </summary>
          <div class="knr-faq__answer rte">{{ item.answer | metafield_tag }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for item in items -%}
          {%- liquid
            assign answer_text = item.answer | metafield_tag | strip_html | strip
            assign answer_text = answer_text | replace: '&#39;', "'" | replace: '&quot;', '"'
            assign answer_text = answer_text | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&amp;', '&'
          -%}
          {
            "@type": "Question",
            "name": {{ item.question.value | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ answer_text | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>

  <script src="{{ 'accordion.js' | asset_url }}" type="module" defer></script>
{%- endif -%}

{% stylesheet %}
  .knr-faq {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-10);
    padding-inline: var(--space-6);
  }

  .knr-faq__heading {
    text-align: center;
  }

  .knr-faq__list {
    width: 100%;
    max-width: var(--layout-narrow);
  }

  .knr-faq__item {
    padding-block: var(--space-5);
    box-shadow: inset 0 var(--border-base) 0 var(--color-border);
  }

  .knr-faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    font-size: var(--text-xl);
    line-height: var(--text-xl--line-height);
    letter-spacing: var(--tracking-tight);
    cursor: pointer;
  }

  .knr-faq__question:hover {
    opacity: 0.7;
  }

  .knr-faq__chevron {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 0.5rem;
    height: 0.25rem;
  }

  .knr-faq__chevron .icon-chevron {
    flex: none;
    width: 0.4009rem;
    height: 0.6768rem;
    transform: rotate(90deg);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .knr-faq__item[open]:not(.is-collapsing) .icon-chevron {
    transform: rotate(-90deg);
  }

  .knr-faq__answer {
    margin-top: var(--space-4);
  }

  @media (min-width: 1024px) {
    .knr-faq {
      gap: var(--space-20);
      padding-inline: var(--space-10);
    }

    .knr-faq__question {
      letter-spacing: var(--tracking-tighter);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "KNR - FAQ",
  "tag": "section",
  "class": "knr-faq-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions fréquentes"
    },
    {
      "type": "metaobject_list",
      "id": "items",
      "label": "Questions",
      "metaobject_type": "faq_item",
      "limit": 20,
      "info": "Connect to the product's FAQ metafield."
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question",
      "default": true
    },
    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Inner padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Inner padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Outer margin top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Outer margin bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "custom_mobile_spacing",
      "label": "Custom mobile spacing",
      "default": true,
      "info": "Off: mobile uses half the desktop values."
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Inner padding top (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.custom_mobile_spacing }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Inner padding bottom (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.custom_mobile_spacing }}"
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "label": "Outer margin top (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.custom_mobile_spacing }}"
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "label": "Outer margin bottom (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.custom_mobile_spacing }}"
    }
  ],
  "presets": [
    {
      "name": "KNR - FAQ"
    }
  ]
}
{% endschema %}
