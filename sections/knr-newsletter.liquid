<div
  class="knr-newsletter section-spacing color-{{ section.settings.color_scheme }}"
  {% render 'section-spacing', s: section.settings %}
>
  <div class="knr-newsletter__inner layout">
    <div class="knr-newsletter__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1360
          | image_tag:
            widths: '342,684,680,1020,1360',
            sizes: '(min-width: 1024px) 47vw, calc(100vw - 3rem)',
            loading: 'lazy',
            alt: section.settings.image.alt
        }}
      {%- endif -%}
    </div>

    <div class="knr-newsletter__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="title-h1">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="knr-newsletter__form-wrapper">
        {%- capture form_id -%}Newsletter-{{ section.id }}{%- endcapture -%}
        {%- form 'customer', id: form_id, class: 'knr-newsletter__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="message message-success knr-newsletter__message" role="status">
              {{- 'sections.newsletter.success' | t -}}
            </p>
          {%- else -%}
            <div class="knr-newsletter__field">
              <label for="NewsletterEmail-{{ section.id }}" class="visually-hidden">
                {{- 'sections.newsletter.label' | t -}}
              </label>
              <input
                id="NewsletterEmail-{{ section.id }}"
                class="field-input knr-newsletter__input"
                type="email"
                name="contact[email]"
                autocomplete="email"
                required
                placeholder="{{ 'sections.newsletter.placeholder' | t | escape }}"
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="NewsletterError-{{ section.id }}"
                {% endif %}
              >
              <button type="submit" class="btn btn-primary knr-newsletter__submit">
                {{- section.settings.button_label -}}
              </button>
            </div>
            {%- if form.errors -%}
              <p id="NewsletterError-{{ section.id }}" class="message message-error" role="alert">
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}

        {%- if section.settings.note != blank -%}
          <p class="text-sm">{{ section.settings.note }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .knr-newsletter__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .knr-newsletter__media {
    position: relative;
    height: 14.5rem;
    overflow: hidden;
    background-color: var(--palette-media);
  }

  .knr-newsletter__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .knr-newsletter__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-10);
  }

  .knr-newsletter__form-wrapper,
  .knr-newsletter__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .knr-newsletter__submit {
    width: 100%;
  }

  @media (min-width: 1024px) {
    .knr-newsletter__inner {
      flex-direction: row;
      gap: 0;
    }

    .knr-newsletter__media,
    .knr-newsletter__content {
      flex: 0 0 50%;
      min-width: 1px;
    }

    .knr-newsletter__media {
      height: 33.75rem;
    }

    .knr-newsletter__content {
      padding-inline: var(--space-10);
    }

    .knr-newsletter__field {
      flex-direction: row;
      gap: 0;
    }

    .knr-newsletter__input {
      flex: 1 1 0;
      min-width: 1px;
      border-right: 0;
      border-radius: var(--radius-sm) 0 0 var(--radius-sm);
    }

    .knr-newsletter__submit {
      flex: none;
      width: 10rem;
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "KNR - Newsletter",
  "tag": "section",
  "class": "knr-newsletter-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "S’inscrire"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note",
      "info": "Short text under the form."
    },
    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Inner padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Inner padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Outer margin top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Outer margin bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "custom_mobile_spacing",
      "label": "Custom mobile spacing",
      "default": true,
      "info": "Off: mobile uses half the desktop values."
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Inner padding top (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.custom_mobile_spacing }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Inner padding bottom (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ section.settings.custom_mobile_spacing }}"
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "label": "Outer margin top (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.custom_mobile_spacing }}"
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "label": "Outer margin bottom (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.custom_mobile_spacing }}"
    }
  ],
  "presets": [
    {
      "name": "KNR - Newsletter"
    }
  ]
}
{% endschema %}
