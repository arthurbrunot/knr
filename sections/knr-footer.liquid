<footer class="knr-footer color-{{ section.settings.color_scheme }}">
  <div class="knr-footer__top layout">
    {%- for i in (1..3) -%}
      {%- liquid
        case i
          when 1
            assign menu = section.settings.menu_1
          when 2
            assign menu = section.settings.menu_2
          when 3
            assign menu = section.settings.menu_3
        endcase
      -%}
      {%- if menu.links.size > 0 -%}
        <nav class="knr-footer__column" aria-label="{{ menu.title | escape }}">
          <h2 class="knr-footer__heading text-base">{{ menu.title }}</h2>
          <ul class="knr-footer__links" role="list">
            {%- for link in menu.links -%}
              <li>
                <a href="{{ link.url }}" class="knr-footer__link text-base">{{ link.title }}</a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>

        <details class="knr-footer__accordion" data-accordion>
          <summary class="knr-footer__summary text-base">
            {{- menu.title -}}
            <span class="knr-footer__chevron">{% render 'icon-chevron' %}</span>
          </summary>
          <ul class="knr-footer__links" role="list">
            {%- for link in menu.links -%}
              <li>
                <a href="{{ link.url }}" class="knr-footer__link text-base">{{ link.title }}</a>
              </li>
            {%- endfor -%}
          </ul>
        </details>
      {%- endif -%}
    {%- endfor -%}

    <div class="knr-footer__about">
      {%- if section.settings.about_heading != blank -%}
        <h2 class="text-base">{{ section.settings.about_heading }}</h2>
      {%- endif -%}
      {%- if section.settings.about_text != blank -%}
        <div class="knr-footer__about-text text-base">{{ section.settings.about_text }}</div>
      {%- endif -%}

      {%- if section.settings.certification_logo != blank
        or section.settings.certification_text != blank
      -%}
        <div class="knr-footer__certification">
          {%- if section.settings.certification_logo != blank -%}
            {{
              section.settings.certification_logo
              | image_url: width: 141
              | image_tag:
                class: 'knr-footer__certification-logo',
                widths: '47,94,141',
                sizes: '3rem',
                loading: 'lazy',
                alt: section.settings.certification_logo.alt
            }}
          {%- endif -%}
          {%- if section.settings.certification_text != blank -%}
            <p class="knr-footer__certification-text text-base">
              {{ section.settings.certification_text }}
            </p>
          {%- endif -%}
          {%- if section.settings.certification_link != blank
            and section.settings.certification_link_label != blank
          -%}
            <a href="{{ section.settings.certification_link }}" class="link">
              {{- section.settings.certification_link_label -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="knr-footer__wordmark">
    {% render 'logo-wordmark', class: 'knr-footer__wordmark-svg' %}
    <span class="visually-hidden">{{ shop.name }}</span>
  </div>

  <div class="knr-footer__bottom">
    <div class="knr-footer__bottom-inner layout">
      <div class="knr-footer__localization">
        {%- form 'localization',
          id: 'FooterLocalization',
          class: 'knr-footer__localization-form'
        -%}
          {%- if localization.available_countries.size > 1 -%}
            <div class="knr-footer__select">
              <label for="FooterCountry" class="visually-hidden">
                {{- 'sections.footer.country' | t -}}
              </label>
              <span class="knr-footer__select-value" aria-hidden="true">
                {{- localization.country.name }} ({{ localization.country.currency.symbol }})
              </span>
              <select id="FooterCountry" name="country_code" data-localization-select>
                {%- for country in localization.available_countries -%}
                  <option
                    value="{{ country.iso_code }}"
                    {% if country.iso_code == localization.country.iso_code %}
                      selected
                    {% endif %}
                  >
                    {{- country.name }} ({{ country.currency.symbol }})
                  </option>
                {%- endfor -%}
              </select>
              <span class="knr-footer__chevron" aria-hidden="true">
                {%- render 'icon-chevron' -%}
              </span>
            </div>
          {%- endif -%}
          {%- if localization.available_languages.size > 1 -%}
            <div class="knr-footer__select">
              <label for="FooterLanguage" class="visually-hidden">
                {{- 'sections.footer.language' | t -}}
              </label>
              <span class="knr-footer__select-value" aria-hidden="true">
                {{- localization.language.endonym_name | capitalize -}}
              </span>
              <select id="FooterLanguage" name="locale_code" data-localization-select>
                {%- for language in localization.available_languages -%}
                  <option
                    value="{{ language.iso_code }}"
                    lang="{{ language.iso_code }}"
                    {% if language.iso_code == localization.language.iso_code %}
                      selected
                    {% endif %}
                  >
                    {{- language.endonym_name | capitalize -}}
                  </option>
                {%- endfor -%}
              </select>
              <span class="knr-footer__chevron" aria-hidden="true">
                {%- render 'icon-chevron' -%}
              </span>
            </div>
          {%- endif -%}
          <noscript>
            <button type="submit" class="link">{{ 'sections.footer.update' | t }}</button>
          </noscript>
        {%- endform -%}
      </div>

      {%- assign current_year = 'now' | date: '%Y' -%}
      <p class="knr-footer__copyright">
        {{- 'sections.footer.copyright' | t: year: current_year, shop: shop.name -}}
      </p>

      <ul class="knr-footer__socials" role="list">
        {%- liquid
          assign networks = 'facebook,instagram,tiktok,linkedin' | split: ','
        -%}
        {%- for network in networks -%}
          {%- assign setting_id = 'social_' | append: network -%}
          {%- assign url = section.settings[setting_id] -%}
          {%- if url != blank -%}
            <li>
              <a href="{{ url }}" class="knr-footer__social" target="_blank" rel="noopener">
                {%- case network -%}
                  {%- when 'facebook' -%}
                    {% render 'icon-facebook' %}
                  {%- when 'instagram' -%}
                    {% render 'icon-instagram' %}
                  {%- when 'tiktok' -%}
                    {% render 'icon-tiktok' %}
                  {%- when 'linkedin' -%}
                    {% render 'icon-linkedin' %}
                {%- endcase -%}
                <span class="visually-hidden">{{ network | capitalize }}</span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
</footer>

<script src="{{ 'knr-footer.js' | asset_url }}" type="module" defer></script>
<script src="{{ 'accordion.js' | asset_url }}" type="module" defer></script>

{% stylesheet %}
  .knr-footer {
    padding-bottom: var(--sticky-buy-offset, 0px);
  }

  .knr-footer__top {
    display: flex;
    flex-direction: column;
    padding-block: var(--space-16) var(--space-10);
  }

  .knr-footer__column {
    display: none;
  }

  .knr-footer__accordion {
    padding-block: var(--space-4);
    box-shadow: inset 0 var(--border-base) 0 var(--color-border);
  }

  .knr-footer__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
  }

  .knr-footer__chevron {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 0.5rem;
    height: 0.25rem;
  }

  .knr-footer__chevron .icon-chevron {
    flex: none;
    width: 0.4009rem;
    height: 0.6768rem;
    transform: rotate(90deg);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .knr-footer__accordion[open]:not(.is-collapsing) .icon-chevron {
    transform: rotate(-90deg);
  }

  .knr-footer__accordion .knr-footer__links {
    padding-top: var(--space-4);
  }

  .knr-footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .knr-footer__link {
    transition: opacity var(--duration-fast) ease;
  }

  .knr-footer__link:hover {
    opacity: 0.6;
  }

  .knr-footer__about {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-top: var(--space-10);
  }

  .knr-footer__certification {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .knr-footer__certification-logo {
    width: 2.9375rem;
    height: 3.5rem;
    object-fit: contain;
  }

  .knr-footer__certification .link {
    padding-bottom: 0;
  }

  .knr-footer__certification-text {
    align-self: stretch;
    padding-bottom: var(--space-4);
    box-shadow: inset 0 calc(var(--border-base) * -1) 0 var(--palette-accent-light);
  }

  .knr-footer__wordmark-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .knr-footer__bottom {
    margin-top: var(--space-10);
    padding-block: var(--space-10);
    font-size: var(--text-base);
    line-height: 1rem;
    letter-spacing: var(--tracking-tighter);
    box-shadow: inset 0 var(--border-base) 0 var(--palette-accent-light);
  }

  .knr-footer__bottom-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .knr-footer__localization-form {
    display: flex;
    gap: var(--space-4);
  }

  .knr-footer__select {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .knr-footer__select select {
    position: absolute;
    inset: 0;
    width: 100%;
    opacity: 0;
    cursor: pointer;
    appearance: none;
  }

  .knr-footer__select:has(select:focus-visible) {
    outline: var(--border-base) solid currentColor;
    outline-offset: 2px;
  }

  .knr-footer__select .knr-footer__chevron {
    width: 1rem;
    pointer-events: none;
  }

  .knr-footer__socials {
    display: flex;
    gap: var(--space-4);
  }

  .knr-footer__social {
    display: flex;
    transition: opacity var(--duration-fast) ease;
  }

  .knr-footer__social:hover {
    opacity: 0.6;
  }

  .knr-footer__social .icon {
    width: var(--icon-lg);
    height: var(--icon-lg);
  }

  @media (min-width: 1024px) {
    .knr-footer__top {
      flex-direction: row;
      gap: var(--space-10);
      padding-block: var(--space-20) var(--space-10);
    }

    .knr-footer__accordion {
      display: none;
    }

    .knr-footer__column {
      display: block;
      flex: 1 1 0;
      min-width: 1px;
    }

    .knr-footer__heading {
      padding-bottom: var(--space-6);
    }

    .knr-footer__about {
      flex: none;
      width: 25rem;
      margin-top: 0;
    }

    .knr-footer__wordmark {
      max-width: var(--layout-max-width);
      margin: 0 auto;
      padding-inline: var(--layout-px);
    }

    .knr-footer__bottom {
      margin-top: var(--space-20);
      line-height: var(--text-base--line-height);
      letter-spacing: var(--tracking-tight);
    }

    .knr-footer__bottom-inner {
      flex-direction: row;
    }

    .knr-footer__localization,
    .knr-footer__socials {
      flex: 1 1 0;
      min-width: 1px;
    }

    .knr-footer__socials {
      justify-content: flex-end;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "KNR - Footer",
  "tag": "div",
  "class": "knr-footer-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "surface"
    },
    { "type": "header", "content": "Menus" },
    { "type": "link_list", "id": "menu_1", "label": "Menu 1" },
    { "type": "link_list", "id": "menu_2", "label": "Menu 2" },
    { "type": "link_list", "id": "menu_3", "label": "Menu 3" },
    { "type": "header", "content": "About" },
    { "type": "text", "id": "about_heading", "label": "Heading" },
    { "type": "richtext", "id": "about_text", "label": "Text" },
    { "type": "image_picker", "id": "certification_logo", "label": "Certification logo" },
    { "type": "text", "id": "certification_text", "label": "Certification text" },
    { "type": "text", "id": "certification_link_label", "label": "Certification link label" },
    { "type": "url", "id": "certification_link", "label": "Certification link" },
    { "type": "header", "content": "Social media" },
    { "type": "url", "id": "social_facebook", "label": "Facebook" },
    { "type": "url", "id": "social_instagram", "label": "Instagram" },
    { "type": "url", "id": "social_tiktok", "label": "TikTok" },
    { "type": "url", "id": "social_linkedin", "label": "LinkedIn" }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
