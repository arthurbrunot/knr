<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    {% render 'head-meta' %}

    {%- unless settings.favicon == blank -%}
      <link
        rel="shortcut icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endunless -%}

    <title>
      {{ page_title }}
      {%- unless page_title contains shop.name %}
        &ndash; {{ shop.name -}}
      {%- endunless -%}
    </title>

    <link rel="canonical" href="{{ canonical_url }}">
    <link
      rel="preconnect"
      href="https://cdn.shopify.com"
      crossorigin
    >

    {% render 'fonts' %}

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {% render 'css-variables' %}

    {{ content_for_header }}

    {% render 'head-scripts' %}
  </head>

  <body class="password-template">
    <main id="main-content" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
